# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_TIMEOUT_SECONDS=15

# Initial notification provider: ntfy
NOTIFICATION_PROVIDER=NTFY
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NOTIFICATION_TIMEOUT_SECONDS=10

# OANDA practice API (read-only market data connector)
OANDA_API_TOKEN=

# Optional Deriv Options demo account (read-only connector)
MARKET_DATA_PROVIDER=BIQUOTE
DERIV_API_TOKEN=
DERIV_APP_ID=
DERIV_DEMO_ACCOUNT_ID=

# MetaTrader 5
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server

# Scanner settings
SCAN_INTERVAL=60
ALERT_COOLDOWN_MINUTES=60

# Local AI advisory (disabled by default; requires Ollama and the selected local model)
AI_ADVISOR_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=75

# Risk management
SIMULATION_ACCOUNT_BALANCE=10.0
SIMULATION_ACCOUNT_CURRENCY=USD
MAX_RISK_PER_TRADE=2.0
SIMULATION_RR_MULTIPLE=2.0
# Set these from the actual XAUUSD CFD broker symbol specification.
# Leave unset when the selected provider cannot supply contract/volume metadata.
XAUUSD_CONTRACT_SIZE=
BROKER_MIN_VOLUME=
BROKER_VOLUME_STEP=
BROKER_MAX_VOLUME=
MAX_DAILY_DRAWDOWN=3.0
MAX_WEEKLY_DRAWDOWN=6.0
MAX_CONSECUTIVE_LOSSES=3

# News filter
NEWS_FILTER_ENABLED=true
NEWS_BLOCK_MINUTES_BEFORE=30
NEWS_BLOCK_MINUTES_AFTER=15

# Database
DB_PATH=trading_scanner.db
